# Kopieren nach ".env" und anpassen.

# true = lokaler Dev-Modus ohne echte Nextcloud (siehe main.py)
STANDALONE_MODE=true

DATABASE_URL=sqlite:///./data/vehicle_tracker.db

OCR_ENGINE=paddleocr
OCR_LANG=de

# Sprache der Talk-Bot-Nachrichten (siehe app/i18n.py) - aktuell nur "de" hinterlegt
APP_LOCALE=de

# Optionaler lokaler LLM-Fallback fuer unklare Belege (siehe app/ocr/llm_fallback.py)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_URL=http://localhost:11434
LLM_FALLBACK_MODEL=qwen2.5:1.5b-instruct

# Fuer eigenes Reverse-Geocoding statt des oeffentlichen Nominatim-Diensts:
# NOMINATIM_URL=https://nominatim.witt14.de/reverse
